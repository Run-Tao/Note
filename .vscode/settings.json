{
  // ===== C/C++ 语言服务 =====
  "C_Cpp.default.compilerPath": "D:/Program Files/mingw64/bin/g++.exe",
  "C_Cpp.default.cppStandard": "c++17",
  "C_Cpp.default.cStandard": "c17",
  "C_Cpp.default.intelliSenseMode": "windows-gcc-x64",
  "C_Cpp.default.includePath": [
    "${workspaceFolder}/**"
  ],

  // ===== Code Runner（右键 → Run Code 也能用）=====
  "code-runner.runInTerminal": true,
  "code-runner.saveFileBeforeRun": true,
  "code-runner.clearPreviousOutput": true,
  "code-runner.executorMap": {
    "c": "cd $dir && gcc -std=c17 -Wall -Wextra -fexec-charset=UTF-8 $fileName -o $fileNameWithoutExt.exe && $dir$fileNameWithoutExt.exe",
    "cpp": "cd $dir && g++ -std=c++17 -Wall -Wextra -fexec-charset=UTF-8 $fileName -o $fileNameWithoutExt.exe && $dir$fileNameWithoutExt.exe"
  },
  "code-runner.executorMapByGlob": {
    "*.cpp": "cd $dir && g++ -std=c++17 -Wall -Wextra -fexec-charset=UTF-8 $fileName -o $fileNameWithoutExt.exe && $dir$fileNameWithoutExt.exe"
  },

  // ===== 文件关联与编码 =====
  "files.associations": {
    "*.cpp": "cpp",
    "*.cc": "cpp",
    "*.cxx": "cpp",
    "*.h": "cpp",
    "*.hpp": "cpp",
    "*.tcc": "cpp",
    "CMakeLists.txt": "cmake"
  },
  "files.encoding": "utf8",
  "files.eol": "\r\n",
  "[cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.formatOnSave": false
  },
  "[c]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "editor.tabSize": 4
  },

  // ===== 终端设置 =====
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.env.windows": {
    "PATH": "D:\\Program Files\\mingw64\\bin;${env:PATH}"
  },

  // ===== 让 Obsidian 笔记里的 .exe 等不干扰 =====
  "files.exclude": {
    "**/*.exe": true,
    "**/*.o": true,
    "**/*.out": true
  },
  "search.exclude": {
    "**/*.exe": true
  }
}
